{
  "name": "qluely",
  "private": true,
  "version": "2.0.7",
  "description": "AI-powered desktop assistant with chat, image analysis, and screen capture functionality",
  "author": {
    "name": "0xlabsorg",
    "email": "sameer@qluely.in"
  },
  "type": "module",
  "main": "dist-app/electron/main.js",
  "scripts": {
    "dev": "npm run build:web-dev && npm run build:app && npm run dev:app",
    "dev:web": "vite",
    "dev:app": "node scripts/dev-app.mjs",
    "build": "npm run build:web && npm run build:app",
    "build:web": "tsc -b && vite build",
    "build:web-dev": "tsc -b && vite build --mode development",
    "build:app": "tsc --project src/electron/tsconfig.json && tsc --project src/electron/tsconfig.preload.json",
    "setup": "node scripts/setup-ffmpeg.mjs",
    "lint": "eslint .",
    "app": "npx electron-builder",
    "preview": "vite preview",
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "win-app": "npx electron-builder --win",
    "mac-app": "npx electron-builder --mac",
    "linux-app": "npx electron-builder --linux"
  },
  "dependencies": {
    "@deepgram/sdk": "^4.11.3",
    "@elevenlabs/elevenlabs-js": "^2.34.0",
    "@radix-ui/react-slot": "^1.2.4",
    "@tabler/icons-react": "^3.36.1",
    "@tailwindcss/vite": "^4.1.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.3.1",
    "electron-audio-loopback": "^1.0.6",
    "electron-squirrel-startup": "^1.0.1",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.6.2",
    "lucide-react": "^0.562.0",
    "marked": "^17.0.1",
    "mermaid": "^11.12.2",
    "motion": "^12.34.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^6.30.3",
    "react-syntax-highlighter": "^16.1.0",
    "shiki": "^3.20.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-dmg": "^7.11.1",
    "@electron-forge/maker-rpm": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.1",
    "@electron-forge/plugin-fuses": "^7.11.1",
    "@electron/fuses": "^1.8.0",
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.9",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^39.2.7",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.3",
    "vite": "^7.2.2"
  }
}
